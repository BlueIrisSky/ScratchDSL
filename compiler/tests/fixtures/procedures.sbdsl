@var score = 0
@list logs = []
定义自制积木 加分 数量: @n @warp { [将 $score 增加 @n] }
定义自制积木 公共入口 { [加分 数量: 2] }
定义自制积木 递归 次数: @n @warp {
    如果 <@n > 0> 那么 {
        [将 "tick" 加入 $list:logs]
        [递归 次数: (@n - 1)]
    }
}
定义自制积木 布尔测试 <@flag> {
    如果 <@flag> 那么 { [将 $score 增加 1] }
}
@sprite "玩家" {
    @init {}
    @var score = 100
    定义自制积木 加分 数量: @n { [将 $score 增加 @n] }
    当绿旗被点击 {
        [加分 数量: 3]
        [公共入口]
        [递归 次数: 3]
        [布尔测试 <true>]
        [布尔测试 <false>]
    }
}
