{
  "name": "scratchdsl",
  "displayName": "ScratchDSL",
  "description": "ScratchDSL 语法高亮、诊断、补全与工程构建。",
  "version": "0.3.0",
  "publisher": "scratchdsl",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BlueIrisSky/ScratchDSL.git",
    "directory": "vscode"
  },
  "homepage": "https://github.com/BlueIrisSky/ScratchDSL#readme",
  "bugs": {
    "url": "https://github.com/BlueIrisSky/ScratchDSL/issues"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:sbdsl",
    "onLanguage:sbdsl-build"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "受限模式仅提供语言服务，不执行工程中的 JavaScript 扩展或构建命令。",
      "restrictedConfigurations": [
        "scratchdsl.serverPath"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "sbdsl",
        "aliases": [
          "ScratchDSL",
          "sbdsl"
        ],
        "extensions": [
          ".sbdsl"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/sbdsl-light.svg",
          "dark": "./icons/sbdsl-dark.svg"
        }
      },
      {
        "id": "sbdsl-build",
        "aliases": [
          "ScratchDSL Build",
          "sbdsl-build"
        ],
        "filenames": [
          "sbdsl.buildsb"
        ],
        "extensions": [
          ".buildsb"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/buildsb-light.svg",
          "dark": "./icons/buildsb-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "sbdsl",
        "scopeName": "source.sbdsl",
        "path": "./syntaxes/sbdsl.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.buildsb.sbdsl": "sbdsl-build"
        }
      },
      {
        "language": "sbdsl-build",
        "scopeName": "source.sbdsl-build",
        "path": "./syntaxes/buildsb.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "scratchdsl.restartServer",
        "title": "ScratchDSL: 重启语言服务器"
      },
      {
        "command": "scratchdsl.showOutput",
        "title": "ScratchDSL: 显示输出"
      },
      {
        "command": "scratchdsl.build",
        "title": "ScratchDSL: 构建工程",
        "enablement": "isWorkspaceTrusted",
        "icon": "$(tools)"
      },
      {
        "command": "scratchdsl.check",
        "title": "ScratchDSL: 检查工程",
        "enablement": "isWorkspaceTrusted"
      }
    ],
    "configuration": {
      "title": "ScratchDSL",
      "properties": {
        "scratchdsl.serverPath": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "可选的 sbdsl.exe 绝对路径。留空使用插件自带版本；不通过 PATH 搜索。未信任工作区中的设置会被忽略。"
        },
        "scratchdsl.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "语言服务器协议日志。"
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "scratchdsl.build",
          "when": "resourceScheme == file && resourceExtname == .buildsb",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc --noEmit && node build.mjs",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && npm run test:grammar",
    "test:grammar": "node --test test/grammar.test.cjs",
    "test:host": "npm run compile && node test/run-host.cjs"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.2"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
