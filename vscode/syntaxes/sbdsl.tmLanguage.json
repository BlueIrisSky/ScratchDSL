            {
              "include": "#values"
            }
          ]
        }
      ]
    },
    "arithmetic-left": {
      "patterns": [
        {
          "begin": "((?:-?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?|(?:\\$(?:global:)?(?:list:)?|@)(?:[\\p{L}_][\\p{L}\\p{Nd}_]*|\"(?:[^\"\\\\\\r\\n]|\\\\.)*\")|/'(?:[^'\\\\\\r\\n]|\\\\.)*'/|\"(?:[^\"\\\\\\r\\n]|\\\\.)*\"))",
