{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ScratchDSL",
  "scopeName": "source.sbdsl",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#indented-init"
    },
    {
      "include": "#invalid-data-assignment"
    },
    {
      "include": "#retired-declaration"
    },
    {
      "include": "#list-assignment"
    },
    {
      "include": "#assignment"
    },
    {
      "include": "#sprite"
    },
    {
      "include": "#import"
    },
    {
      "include": "#procedure"
    },
    {
      "name": "storage.modifier.sbdsl",
      "match": "(?<![\\p{L}\\p{Nd}_$])@warp\\b"
    },
    {
      "name": "keyword.control.sbdsl",
      "match": "(?<![\\p{L}\\p{Nd}_$@])(?:stage|sprite|init|add|pass)\\b(?!:)"
    },
    {
      "include": "#control"
    },
    {
      "include": "#extension-control"
    },
    {
      "include": "#event"
    },
    {
      "include": "#command"
    },
    {
      "name": "punctuation.section.block.begin.sbdsl",
      "match": ":(?=[ \\t]*(?:#.*)?$)"
    },
    {
      "name": "punctuation.section.sbdsl",
      "match": "[}\\])]|>(?!\\*)"
    }
  ],
  "repository": {
    "extension-control": {
      "name": "meta.control.extension.sbdsl",
      "begin": "^[ \\t]*(?=(?:[\\p{L}_][\\p{L}\\p{Nd}_.-]*|\"(?:[^\"\\\\\\r\\n]|\\\\.)*\")(?:\\.|::).*:[ \\t]*(?:#.*)?$)",
      "end": "(?=:[ \\t]*(?:#.*)?$|$)",
      "patterns": [
        {
          "include": "#list-command-values"
        },
        {
          "include": "#values"
        },
        {
          "name": "support.function.command.sbdsl",
          "match": "[^\\s\\[\\](){}<>\"\\'/$@#,+*=]+|[+*=]"
        }
      ]
    },
    "dsl-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.sbdsl",
          "match": "\\\\[\"\\\\nr]"
        },
        {
          "name": "invalid.illegal.escape.sbdsl",
          "match": "\\\\."
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.sbdsl",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "include": "#dsl-escapes"
        }
      ],
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.sbdsl"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.sbdsl"
        }
      }
    },
    "menus": {
      "patterns": [
        {
          "name": "meta.menu.sbdsl",
          "contentName": "string.quoted.single.menu.sbdsl",
          "begin": "'",
          "end": "'|$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.menu.begin.sbdsl"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.menu.end.sbdsl"
            }
          },
          "patterns": [
            {
              "include": "#menu-escapes"
            }
          ]
        }
      ]
    },
    "references": {
      "patterns": [
        {
          "name": "invalid.illegal.reference.sbdsl",
          "match": "\\$(?:global:)?(?:list:)?(?:[\\p{L}_][\\p{L}\\p{Nd}_]*|\"(?:[^\"\\\\\\r\\n]|\\\\.)*\"|\"[^\\r\\n]*)?"
        },
        {
          "name": "invalid.illegal.reference.sbdsl",
          "match": "(?<![\\p{L}\\p{Nd}_$@:])(?:(?:global:list:|list:|var:)(?:[\\p{L}_][\\p{L}\\p{Nd}_]*|\"(?:[^\"\\\\\\r\\n]|\\\\.)*\"|\"[^\\r\\n]*)|global:\"(?:[^\"\\\\\\r\\n]|\\\\.)*\")"
        },
        {
          "name": "variable.other.readwrite.sbdsl",
          "match": "(?<![\\p{L}\\p{Nd}_$@:])global:[\\p{L}_][\\p{L}\\p{Nd}_]*(?![\\p{L}\\p{Nd}_:])"
        },
        {
          "name": "variable.parameter.sbdsl",
          "begin": "@\"",
          "end": "\"|$",
          "patterns": [
            {
              "include": "#dsl-escapes"
            }
          ]
        },
        {
          "name": "variable.parameter.sbdsl",
          "match": "@(?!warp\\b)[\\p{L}_][\\p{L}\\p{Nd}_]*"
        }
      ]
    },
    "boolean-parameter": {
      "match": "(<)(@(?:[\\p{L}_][\\p{L}\\p{Nd}_]*|\"(?:[^\"\\\\\\r\\n]|\\\\.)*\"))(>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.boolean.begin.sbdsl"
        },
        "2": {
          "name": "variable.parameter.boolean.sbdsl",
          "patterns": [
            {
              "include": "#dsl-escapes"
            }
          ]
        },
        "3": {
          "name": "punctuation.definition.boolean.end.sbdsl"
        }
      }
    },
    "numbers": {
      "name": "constant.numeric.sbdsl",
      "match": "(?<![\\w.])-?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\w.])"
    },
    "operators": {
      "patterns": [
        {
          "name": "invalid.illegal.operator.sbdsl",
          "match": "(?<![+*/=<>-])(?:\\+\\*|-\\*|\\*\\*|=\\*|<\\*|>\\*)"
        },
        {
          "name": "keyword.operator.sbdsl",
          "match": "(?<![+*/=<-])(?:\\+(?!\\*)|-(?!\\*)|\\*(?!\\*)|=(?!\\*))"
        }
      ]
    },
    "namespaces": {
      "patterns": [
        {
          "match": "((?<![\\p{L}\\p{Nd}_.-])[\\p{L}_][\\p{L}\\p{Nd}_.-]*|\"(?:[^\"\\\\\\r\\n]|\\\\.)*\")(?:(\\.)|(?=::))",
          "captures": {
            "1": {
              "name": "entity.name.namespace.sbdsl",
              "patterns": [
                {
                  "include": "#dsl-escapes"
                }
              ]
            },
            "2": {
              "name": "punctuation.separator.namespace.sbdsl"
            }
          }
        },
        {
          "match": "(::)(\"(?:[^\"\\\\\\r\\n]|\\\\.)*\")(?=\\()",
          "captures": {
            "1": {
              "name": "punctuation.separator.namespace.sbdsl"
            },
            "2": {
              "name": "entity.name.function.opcode.sbdsl",
              "patterns": [
                {
                  "include": "#dsl-escapes"
                }
              ]
            }
          }
        },
        {
          "name": "punctuation.separator.namespace.sbdsl",
          "match": "\\.(?![0-9])"
        }
      ]
    },
    "values": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#retired-delimiters"
        },
        {
          "include": "#namespaces"
        },
        {
          "include": "#menus"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#boolean-parameter"
        },
        {
          "include": "#comparison"
        },
        {
          "include": "#references"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#infix-reporter"
        },
        {
          "include": "#reporter"
        },
        {
          "include": "#boolean"
        },
        {
          "name": "punctuation.separator.sbdsl",
          "match": ","
        }
      ]
    },
    "command": {
      "name": "meta.block.command.sbdsl",
      "begin": "(?=[^\\s:})])",
      "end": "(?=:[ \\t]*(?:#.*)?$|$)",
      "patterns": [
        {
          "include": "#list-command-values"
        },
        {
          "include": "#values"
        },
        {
          "name": "support.function.command.sbdsl",
          "match": "[^\\s\\[\\](){}<>\"\\'/$@#,+*=]+|[+*=]"
        }
      ]
    },
    "reporter": {
      "name": "meta.block.reporter.sbdsl",
      "begin": "\\(",
      "end": "\\)|(?=[{}])|(?=^[ \\t]*(?:\\[|(?:stage|sprite|init|var|list|global|def|start|if|elif|else|loop|while)\\b))",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.reporter.begin.sbdsl"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.reporter.end.sbdsl"
        }
      },
      "patterns": [
        {
          "include": "#known-reporters"
        },
        {
          "match": "(?<=\\()((?:global:)?[\\p{L}_][\\p{L}\\p{Nd}_]*)(?=[ \\t]*\\))",
          "captures": {
            "1": {
              "name": "variable.other.readwrite.sbdsl"
            }
          }
        },
        {
          "include": "#list-reporter-value"
        },
        {
          "include": "#values"
        },
        {
          "name": "support.function.reporter.sbdsl",
          "match": "[^\\s\\[\\](){}<>\"'/$@#,+*=]+|[+*=]|<(?!\\*)|>(?!\\*)"
        }
      ]
    },
    "boolean": {
      "name": "meta.block.boolean.sbdsl",
      "begin": "<(?!\\*)",
      "end": ">(?!\\*)|(?=[{}])|(?=^[ \\t]*(?:\\[|(?:stage|sprite|init|var|list|global|def|start|if|elif|else|loop|while)\\b))",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.boolean.begin.sbdsl"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.boolean.end.sbdsl"
        }
      },
      "patterns": [
        {
          "include": "#namespaces"
        },
        {
          "name": "constant.language.boolean.sbdsl",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "include": "#comparison-left"
        },
        {
          "include": "#logical-operators"
        },
        {
          "include": "#values"
        },
        {
          "name": "support.function.boolean.sbdsl",
          "match": "[^\\s\\[\\](){}<>\"'/$@#,+*=]+|[+*=]|<(?!\\*)|>(?!\\*)"
        }
      ]
    },
    "list-initializer": {
      "name": "meta.sequence.list.sbdsl",
      "begin": "\\{",
      "end": "\\}|(?=^[ \\t]*(?:\\[|(?:stage|sprite|init|var|list|global|def|start|if|elif|else|loop|while)\\b))",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.list.begin.sbdsl"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.list.end.sbdsl"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "name": "punctuation.separator.sequence.sbdsl",
          "match": ","
        }
      ]
    },
    "sprite": {
      "name": "meta.declaration.sprite.sbdsl",
      "begin": "(?<![\\p{L}\\p{Nd}_@])(sprite)\\b",
      "end": "(?=:|$)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.sbdsl"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "name": "entity.name.type.sprite.sbdsl",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "include": "#dsl-escapes"
            }
          ]
        },
        {
          "name": "keyword.control.sbdsl",
          "match": "\\badd\\b"
        }
      ]
    },
    "import": {
      "name": "meta.import.sbdsl",
      "begin": "\\b(import)\\b",
      "end": "(?=$|[{}])",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.import.sbdsl"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "name": "entity.name.namespace.module.sbdsl",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "include": "#dsl-escapes"
            }
          ]
        },
        {
          "name": "entity.name.namespace.module.sbdsl",
          "match": "[\\p{L}_][\\p{L}\\p{Nd}_]*(?:\\.[\\p{L}_][\\p{L}\\p{Nd}_]*)*"
        }
      ]
    },
    "procedure": {
      "name": "meta.declaration.function.sbdsl",
      "begin": "(def)(?=\\s|$)",
      "end": "(?=:[ \\t]*(?:#.*)?$|$)",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.function.sbdsl"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#boolean-parameter"
        },
        {
          "include": "#references"
        },
        {
          "name": "storage.modifier.sbdsl",
          "match": "@warp\\b"
        },
        {
          "name": "entity.name.function.sbdsl",
          "match": "[^\\s{}<>@#]+"
        }
      ]
    },
    "control": {
      "name": "meta.control.sbdsl",
      "begin": "((?:if|elif|else|loop|while)\\b)",
      "end": "(?=:[ \\t]*(?:#.*)?$|$)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.sbdsl"
        }
      },
      "patterns": [
        {
          "include": "#values"
        },
        {
          "name": "constant.language.boolean.sbdsl",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "include": "#bare-name"
        },
        {
          "name": "keyword.control.sbdsl",
          "match": "[^\\s{}\\[\\]()<>\"/$@#,:+*=]+"
        }
      ]
    },
    "event": {
      "name": "meta.event.sbdsl",
      "begin": "(?=\\S.*:[ \\t]*(?:#.*)?$)",
      "end": "(?=:[ \\t]*(?:#.*)?$|$)",
      "patterns": [
        {
          "include": "#values"
        },
        {
          "name": "keyword.control.event.sbdsl",
          "match": "[^\\s{}\\[\\]()<>\"'/$@#,:+*=]+"
        }
      ]
    },
    "comments": {
      "include": "source.sbdsl-build#comments"
    },
    "infix-reporter": {
      "name": "meta.block.reporter.sbdsl",
      "begin": "\\((?=[ \\t]*(?:[@\\\"\\'(0-9.+-]|global:|[\\p{L}_][\\p{L}\\p{Nd}_]*[ \\t]*(?:[+*/%\\-]|\\))|$))",
      "end": "\\)|(?=[{}])|(?=^[ \\t]*(?:\\[|(?:stage|sprite|init|var|list|global|def|start|if|elif|else|loop|while)\\b))",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.reporter.begin.sbdsl"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.reporter.end.sbdsl"
        }
      },
      "patterns": [
        {
          "include": "#known-reporters"
        },
        {
          "include": "#list-reporter-value"
        },
        {
          "include": "#namespaces"
        },
        {
          "include": "#arithmetic-left"
        },
        {
          "include": "#arithmetic-extra-operators"
        },
        {
          "include": "#values"
        },
        {
          "include": "#arithmetic-name"
        },
        {
          "include": "#bare-name"
        },
        {
          "name": "support.function.reporter.sbdsl",
          "match": "[^\\s\\[\\](){}<>\"'/$@#,+*=]+|[+*=]|<(?!\\*)|>(?!\\*)"
        }
      ]
    },
    "arithmetic-operation": {
      "patterns": [
        {
          "match": "('(?:[^'\\\\\\r\\n]|\\\\.)*')(?=[ \\t]*\\))",
          "captures": {
            "1": {
              "patterns": [
                {
                  "include": "#menus"
                }
              ]
            }
          }
        },
        {
          "name": "meta.expression.binary.sbdsl",
          "begin": "\\+\\*|-\\*|\\*\\*|/\\*|=\\*",
          "beginCaptures": {
            "0": {
              "name": "invalid.illegal.operator.sbdsl"
            }
          },
          "end": "(?=\\))|(?=[{}])|(?=^[ \\t]*(?:\\[|(?:stage|sprite|init|var|list|global|def|start|if|elif|else|loop|while)\\b))",
          "patterns": [
            {
              "include": "#values"
            },
            {
              "include": "#arithmetic-extra-operators"
            },
            {
              "include": "#arithmetic-name"
            }
          ]
        },
        {
          "name": "meta.expression.binary.sbdsl",
          "begin": "\\+(?!\\*)|-(?!\\*)|\\*(?!\\*)|/(?!\\*)|%",
          "beginCaptures": {
            "0": {
              "name": "keyword.operator.sbdsl"
            }
          },
          "end": "(?=\\))|(?=[{}])|(?=^[ \\t]*(?:\\[|(?:stage|sprite|init|var|list|global|def|start|if|elif|else|loop|while)\\b))",
          "patterns": [
            {
              "include": "#arithmetic-right"
            }
          ]
        }
      ]
    },
    "arithmetic-left": {
      "patterns": [
        {
          "begin": "((?:-?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?|(?:global:[\\p{L}_][\\p{L}\\p{Nd}_]*(?![\\p{L}\\p{Nd}_:])|@(?:[\\p{L}_][\\p{L}\\p{Nd}_]*|\"(?:[^\"\\\\\\r\\n]|\\\\.)*\"))|\"(?:[^\"\\\\\\r\\n]|\\\\.)*\"|'(?:[^'\\\\\\r\\n]|\\\\.)*'|[\\p{L}_][\\p{L}\\p{Nd}_]*(?=[ \\t]*(?:[+*/%\\-]|$))))",
          "beginCaptures": {
            "1": {
              "patterns": [
                {
                  "include": "#values"
                },
                {
                  "include": "#bare-name"
                }
              ]
            }
          },
          "end": "(?=\\S)",
          "applyEndPatternLast": true,
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#arithmetic-operation"
            }
          ]
        },
        {
          "begin": "(?=\\()",
          "end": "(?=\\S)",
          "applyEndPatternLast": true,
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#infix-reporter"
            },
            {
              "include": "#reporter"
            },
            {
              "include": "#arithmetic-operation"
            }
          ]
        }
      ]
    },
    "logical-operators": {
      "name": "keyword.operator.logical.sbdsl",
      "match": "(?<![\\p{L}\\p{Nd}_])(?:不成立|与|或)(?![\\p{L}\\p{Nd}_])"
    },
    "menu-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.sbdsl",
          "match": "\\\\(?:['\\\"\\\\/bfnrt]|u[0-9a-fA-F]{4})"
        },
        {
          "name": "invalid.illegal.escape.sbdsl",
          "match": "\\\\."
        }
      ]
    },
    "comparison-operation": {
      "patterns": [
        {
          "name": "meta.expression.comparison.sbdsl",
          "begin": "<\\*|>\\*|=\\*",
          "beginCaptures": {
            "0": {
              "name": "invalid.illegal.operator.sbdsl"
            }
          },
          "end": "(?=[>]|[{}])|(?=^[ \\t]*(?:\\[|(?:stage|sprite|init|var|list|global|def|start|if|elif|else|loop|while)\\b))",
          "patterns": [
            {
              "include": "#values"
            },
            {
              "include": "#bare-name"
            }
          ]
        },
        {
          "name": "meta.expression.comparison.sbdsl",
          "begin": "<(?!\\*)|=(?!\\*)|>(?=[ \\t]*(?:[@\"(0-9.+-]|'|(?!与\\b|或\\b|不成立\\b)[\\p{L}_]|#))|^[ \\t]*>(?=[ \\t]*(?:#|$))",
          "beginCaptures": {
            "0": {
              "name": "keyword.operator.sbdsl",
              "patterns": [
                {
                  "name": "keyword.operator.expression.comparison.sbdsl",
                  "match": "[<>]"
                }
              ]
            }
          },
          "end": "(?=[>]|[{}])|(?=^[ \\t]*(?:\\[|(?:stage|sprite|init|var|list|global|def|start|if|elif|else|loop|while)\\b))",
          "patterns": [
            {
              "include": "#values"
            },
            {
              "include": "#bare-name"
            }
          ]
        }
      ]
    },
    "comparison-left": {
      "patterns": [
        {
          "begin": "((?:-?(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?|(?:global:[\\p{L}_][\\p{L}\\p{Nd}_]*(?![\\p{L}\\p{Nd}_:])|@(?:[\\p{L}_][\\p{L}\\p{Nd}_]*|\"(?:[^\"\\\\\\r\\n]|\\\\.)*\"))|\"(?:[^\"\\\\\\r\\n]|\\\\.)*\"|'(?:[^'\\\\\\r\\n]|\\\\.)*'|[\\p{L}_][\\p{L}\\p{Nd}_]*(?=[ \\t]*$)))",
          "beginCaptures": {
            "1": {
              "patterns": [
                {
                  "include": "#values"
                },
                {
                  "include": "#bare-name"
                }
              ]
            }
          },
          "end": "(?=\\S)",
          "applyEndPatternLast": true,
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#comparison-operation"
            }
          ]
        },
        {
          "begin": "(?=\\(|<(?!\\*))",
          "end": "(?=\\S)",
          "applyEndPatternLast": true,
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#namespaces"
            },
            {
              "include": "#infix-reporter"
            },
            {
              "include": "#reporter"
            },
            {
              "include": "#boolean-parameter"
            },
            {
              "include": "#comparison"
            },
            {
              "include": "#boolean"
            },
            {
              "include": "#comparison-operation"
            }
          ]
        }
      ]
    },
