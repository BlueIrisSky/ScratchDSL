    "init": {
      "name": "meta.embedded.block.buildsb.sbdsl",
      "begin": "(@init)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.sbdsl"
        }
      },
      "end": "(?<=\\})|$",
      "patterns": [
        {
          "include": "source.sbdsl-build#json-values"
        }
      ]
    },
    "comments": {
      "include": "source.sbdsl-build#comments"
    },
    "infix-reporter": {
      "name": "meta.block.reporter.sbdsl",
      "begin": "\\((?=[ \\t]*(?:[$@\"/(0-9.+-]|$))",
      "end": "\\)|(?=[{}])|(?=^[ \\t]*(?:\\[|@(?:stage|init)\\b(?=[ \\t]*\\{)|@sprite\\b(?=[ \\t]+\")|@(?:var|list)\\b(?=[ \\t]+[\\p{L}_\"])|@global\\b(?=[ \\t]+@(?:var|list)\\b)|import\\b|定义自制积木|当|重复执行|循环|如果|否则))",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.reporter.begin.sbdsl"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.reporter.end.sbdsl"
        }
      },
      "patterns": [
        {
          "include": "#arithmetic-left"
        },
        {
          "include": "#values"
        },
        {
          "name": "support.function.reporter.sbdsl",
          "match": "[^\\s\\[\\](){}<>\"/$@#,+*=]+|[+*=]|<(?!\\*)|>(?!\\*)"
        }
      ]
    },
    "arithmetic-operation": {
      "patterns": [
        {
          "match": "(/'(?:[^'\\\\\\r\\n]|\\\\.)*'/)(?=[ \\t]*\\))",
          "captures": {
            "1": {
